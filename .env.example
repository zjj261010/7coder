# ====================== 7coder CONFIG ========================
# API key - REQUIRED for cloud endpoints (OpenAI/Groq/Qwen...).
# Leave EMPTY for keyless local servers (LMStudio / Ollama / vLLM / liteLLM).
OPENAI_API_KEY=

# Optional OpenAI-compatible endpoint (e.g. Groq, local LLM).
# Leave empty to use https://api.openai.com/v1
OPENAI_ENDPOINT=

# Models - heavy for coding/computer tasks, light for moderation/risk
HEAVY_MODEL=gpt-4o-mini
LIGHT_MODEL=gpt-3.5-turbo
# Task-summary light call (AST-R1): model + max_tokens for the 1-2 sentence
# 7CODER.md auto-log. SUMMARY_MODEL empty = use LIGHT_MODEL.
SUMMARY_MODEL=
SUMMARY_MAX_TOKENS=512
VISION_MODEL=

# General
TEMPERATURE=0.6
MAX_TOKENS=42000
# Retries for API calls
MAX_RETRIES=3
# Max tool-call steps per task before forcing a final answer
MAX_TOOL_STEPS=30
# Max characters a single tool result may add to the conversation (head+tail kept)
MAX_TOOL_RESULT_CHARS=30000
# Conversation size limit in characters; older turns get auto-summarized past it
CONTEXT_CHARS=120000
ENABLE_RALPH_MODE=false
# Ralph loop iterations when ENABLE_RALPH_MODE=true (defaults to MAX_RETRIES)
RALPH_ITERATIONS=3

# Permission & Security System
# default | auto | bypass | denial
PERMISSION_MODE=default

# Features
# Set true or use --server flag
ENABLE_HTTP_SERVER=false
HTTP_PORT=7103
# Bind address: 127.0.0.1 = localhost only (recommended).
# Only use 0.0.0.0 for LAN access, and ALWAYS set HTTP_API_KEY then.
HTTP_BIND=127.0.0.1
# Optional API key; when set, clients must send "Authorization: Bearer <key>"
HTTP_API_KEY=
# computer_use: real screenshots + real mouse/keyboard input on Windows
ENABLE_COMPUTER_USE=false
# Enable auto dream mode (self-consolidation of 7CODER.md after >=5h idle)
DREAM_ALLOW=false
# Enable automated app/script debug tool (launch + test + auto-fix loop)
ENABLE_AUTO_DEBUG=true
# Default test duration for auto_debug_tool (2-5)
DEBUG_TEST_MINUTES=3
# Max debate rounds for bickering_tool before forcing compromise
BICKER_ROUNDS=5
# Structured audit log of tool calls/permission changes (.7coder/audit.jsonl)
AUDIT_LOG=true

# MCP - real stdio servers are configured in mcp.json / .7coder/mcp.json
# (see README "MCP (Model Context Protocol)"). Per-call timeout for stdio tools:
MCP_CALL_TIMEOUT=120000
# Legacy bridges (custom HTTP /invoke protocol and npx runner; comma-separated)
MCP_SERVER_URLS=
MCP_NPX_PKGS=

# NOTE: keep comments on their own lines - dotenv 8 does NOT strip inline comments.


# Multiple models on different endpoints/keys? See models.json (README: Multi-Model).